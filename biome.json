{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"app/**/*.ts",
			"app/**/*.vue",
			"server/**/*.ts",
			"shared/**/*.ts",
			"scripts/create-user.ts",
			"prisma/**/*.ts",
			"nuxt.config.ts",
			"app.config.ts",
			"router.ts",
			"package.json",
			"tsconfig.json",
			"biome.json"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useHookAtTopLevel": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"useHookAtTopLevel": "off",
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	],
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
