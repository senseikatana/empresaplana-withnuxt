{
  "name": "empresaplana-website",
  "type": "module",
  "version": "1.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "nuxt:prepare": "nuxt prepare",
    "build:node": "NITRO_PRESET=node_server nuxt build",
    "db:create-user": "tsx scripts/create-user.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "postinstall": "nuxt prepare && prisma generate || exit 0",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "pnpm run db:generate && pnpm run db:push && pnpm run db:seed",
    "release:bump": "node scripts/bump-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "seed:transit": "node scripts/seed-transit.mjs",
    "demo:data": "node scripts/export-demo-data.mjs",
    "demo:build": "NUXT_PUBLIC_STATIC_DEMO=true nuxt generate",
    "deploy:demo": "pnpm demo:data && pnpm demo:build && npx wrangler pages deploy .output/public --project-name empresaplana-demo",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/vue": "^4.0.118",
    "@comark/nuxt": "^0.7.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.118",
    "dotenv": "^17.4.2",
    "googleapis": "^178.1.1",
    "jose": "^6.2.12",
    "katanakit-js": "^3.2.2",
    "leaflet": "^1.9.4",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.131.1"
  },
  "author": "Sergio Jurado - @senseikatana",
  "description": "Website redesign of https://empresaplana.cat at Catalonia Transports Company"
}
