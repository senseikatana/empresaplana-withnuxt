{
	"name": "empresaplana-website",
	"type": "module",
	"version": "1.4.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"@prisma/engines",
		"esbuild",
		"prisma",
		"vue-demi",
		"workerd"
	],
	"scripts": {
		"dev": "nuxt dev",
		"build": "nuxt build",
		"preview": "nuxt preview",
		"tunnel": "cloudflared tunnel --url http://localhost:3000",
		"nuxt:prepare": "nuxt prepare",
		"build:node": "NITRO_PRESET=node_server nuxt build",
		"db:create-user": "tsx scripts/create-user.ts",
		"version:bump": "node scripts/bump-version.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"postinstall": "nuxt prepare && prisma generate || exit 0",
		"db:generate": "prisma generate",
		"db:diff": "prisma migrate diff --from-config-datasource --to-schema=prisma/schema.prisma --script",
		"db:push": "echo 'PROHIBIDO: el DDL va por migraciones InsForge (npx @insforge/cli db migrations new <name> && npx @insforge/cli db migrations up --all). Prisma es solo cliente.' && exit 1",
		"db:migrate": "echo 'PROHIBIDO: Prisma es solo cliente; el DDL va por migraciones InsForge.' && exit 1",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:setup": "bun run db:generate && bun run db:seed",
		"release:bump": "node scripts/bump-version.mjs",
		"release:notes": "node scripts/release-notes.mjs",
		"seed:transit": "node scripts/seed-transit.mjs",
		"demo:data": "node scripts/export-demo-data.mjs",
		"demo:build": "NUXT_PUBLIC_STATIC_DEMO=true nuxt generate",
		"deploy:demo": "bun run demo:data && bun run demo:build && wrangler deploy",
		"typecheck": "nuxi typecheck"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.62",
		"@ai-sdk/vue": "^4.0.127",
		"@comark/nuxt": "^0.7.0",
		"@internationalized/date": "^3.12.4",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/ui": "^4.11.3",
		"@nuxtjs/color-mode": "^4.0.1",
		"@nuxtjs/i18n": "^10.6.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"ai": "^7.0.127",
		"better-auth": "^1.7.7",
		"chart.js": "^4.5.1",
		"dotenv": "^17.4.2",
		"file-type": "^22.1.1",
		"jose": "^6.2.12",
		"katanakit-js": "^3.2.2",
		"nuxt": "^4.5.2",
		"pg": "^8.23.1",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@iconify-json/lucide": "^1.2.139",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vue-tsc": "3.3.11",
		"wrangler": "^4.147.0"
	},
	"author": "Sergio Jurado - @senseikatana",
	"description": "Website redesign of https://empresaplana.cat at Catalonia Transports Company"
}
