# build output
# Sin la barra final a propósito: `nuxt generate` crea un SYMLINK `dist` ->
# `.output/public`, y el patrón `dist/` solo casa con directorios, así que el
# symlink se colaba en `git status` (y el auto-committer podía versionarlo
# con una ruta absoluta local).
dist
dist/

# Nuxt
.nuxt/
.output/

# Wrangler local state
.wrangler/

# generated types
.astro/
.vscode/
.atl/
.cursor/
.codex/
.claude/
.vscode/*.json
generated/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# environment variables
.env
.env.*
!.env.example
.dev.vars

# Google OAuth client secret (never commit)
google.client.json
# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Releases Root Folder 
RELEASES/
RELEASES/*
src/Releases/

# local runtime data (bus tracking store) and agent tooling
.data/
.zcode/
.codegraph/

# fuentes de ingesta, exports y datos locales (no versionar: confidencialidad)
data/

# InsForge & AI agent skills
.insforge
opencode.json
.agent
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf
