# Copiá este archivo a .env y completá con tus valores reales.
# Los valores de aquí son de DEMO: no pongas claves reales en este archivo.

# ── Base de datos InsForge (Postgres) ────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:REPLACE_ME@demo-project.eu-central.database.insforge.app:5432/insforge?sslmode=require"

# ── API InsForge (server-only: nunca exponer al cliente) ─────────────────
INSFORGE_URL="https://demo-project.eu-central.insforge.app"
INSFORGE_API_KEY="ik_demo_replace_me"
INSFORGE_ANON_KEY="anon_demo_replace_me"

# ── Secreto de auth — generar con: openssl rand -base64 32 ───────────────
# Better Auth firma con él las cookies de sesión y el JWT de verificación de
# email (jose HS256). Rotarlo invalida todas las sesiones.
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"

# ── Email transaccional (verificación de cuenta) ─────────────────────────
# Sin RESEND_API_KEY el correo se registra en el log (modo desarrollo).
RESEND_API_KEY=""
MAIL_FROM="Empresa Plana <no-reply@empresaplana.cat>"
# Origen público de la app. EN PRODUCCIÓN es OBLIGATORIA: Better Auth la usa
# como baseURL/trustedOrigins; si falta, el sign-out del navegador responde
# 403 MISSING_OR_NULL_ORIGIN y los links de verificación apuntan a localhost.
APP_URL="http://localhost:3000"

# ── Cloudflare R2 (storage: PDFs, imágenes, media del CMS) ───────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="empresaplana-dev"
R2_PUBLIC_BASE_URL=""

# ── Runtime local ────────────────────────────────────────────────────────
BUS_TRACKING_DATA_FILE=.data/bus-tracking.json

# ── Google OAuth (opcional: login con Google) ────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_CALLBACK_URI="http://localhost:3000/api/auth/oauth/google/callback"

# ── Google Agent API (opcional) ──────────────────────────────────────────
AGENT_API_KEY=""

# ── Google Sheets API (opcional: sync de líneas/horarios) ────────────────
GOOGLE_SPREADSHEET_ID=""

# ── Asistente IA (OpenRouter) ────────────────────────────────────────────
# Gratis: https://openrouter.ai/models?max_price=0
# Default: openrouter/free (router automático entre gratis; el más estable).
# Alternativas cuando no estén rate-limited: qwen/qwen3.8-27b:free,
# google/gemma-4-26b-a4b-it:free (el más rápido).
OPENROUTER_API_KEY=""
ASSISTANT_MODEL="openrouter/free"
# Servidores MCP opcionales (JSON): [{"name":"docs","url":"https://..."}]
MCP_SERVERS=""

# ── Origen de la app con servidor (público) ─────────────────────────────
# El demo estático de Cloudflare no tiene API ni sesión, así que sus enlaces
# de intranet apuntan a la app real. Sin este valor el enlace se oculta
# (preferible a un 404). NUNCA pongas aquí una URL del propio demo estático.
# NUXT_PUBLIC_APP_URL="https://empresaplana.cat"

# ── Login demo de la intranet (portfolio) ───────────────────────────────
# true/ausente: muestra los accesos demo. "false" los oculta (producción real).
# NUXT_PUBLIC_DEMO_LOGIN="false"

# ── Proveedor de IA ────────────────────────────────────────────────────
# "openrouter" (nube, gratis con cuota) u "ollama" (local, sin cuota).
# Desarrollo: ollama — producción (contenedor InsForge): openrouter.
# Con ollama se usa OLLAMA_BASE_URL y, si ASSISTANT_MODEL sigue siendo
# "openrouter/free", cae en DEFAULT_OLLAMA_MODEL (llama3).
ASSISTANT_PROVIDER=""
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
